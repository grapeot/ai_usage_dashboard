# AI Usage Dashboard local configuration.
# You do not need every data source. Keep values fake in this example file.

# Codex: no key required. The tool reads the default local Codex session directory when present.

# Claude Code: no key required. The tool reads default local Claude Code project logs when present.

# OpenCode: no key required for the main local database. Optional archive support can use opencode_skill.
# Leave empty unless you installed or cloned opencode_skill separately.
AI_USAGE_OPENCODE_SKILL_PATH=../opencode_skill/src

# Cursor usage export. Paste a browser cookie only in your private .env.
CURSOR_COOKIE=

# GLM / Z.ai usage API token. Paste a real token only in your private .env.
GLM_BEARER_TOKEN=

# Ollama web settings cookie (full browser cookie string from ollama.com/settings).
# Used to fetch the session/weekly quota bars rendered in the settings HTML.
OLLAMA_COOKIE=

# Local display service defaults.
AI_USAGE_HOST=127.0.0.1
AI_USAGE_PORT=7995

# Cross-machine Antigravity push: satellite (laptop) pushes its entries to the
# dashboard host (e.g. over Tailscale). Set this on the satellite only.
# The dashboard host must run the service bound to 0.0.0.0 or a Tailscale interface.
# Example: http://your-host.your-tailnet.ts.net:7995/api/v1/antigravity/ingest
AI_USAGE_DASHBOARD_INGEST_URL=
# Optional satellite label for logging on the host side.
AI_USAGE_SATELLITE_NAME=
