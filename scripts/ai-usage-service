#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
HOST="${AI_USAGE_HOST:-127.0.0.1}"
PORT="${AI_USAGE_PORT:-7995}"

exec "$PROJECT_DIR/.venv/bin/python" -m uvicorn local_display_service:app --host "$HOST" --port "$PORT"
